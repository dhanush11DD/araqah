# The admin dashboard, payment pages and Moyasar webhook are switched off by default (404).
# Set to true to turn them on. Leave unset to serve only the landing page.
ADMIN_ENABLED=

# Public site address (HTTPS in production). Used for canonical links, the sitemap and the links in emails and payment links.
SITE_URL=https://araqah.com

# MySQL 8 connection. The tables are created automatically on first start.
# Without it, `npm run dev` uses a local SQLite file (.data/dev.sqlite); production refuses to start.
DATABASE_URL=mysql://araqah_user:password@host:3306/araqah

# Secret used to sign admin sessions and encrypt the SMTP password and Moyasar keys saved in the dashboard.
# At least 16 random characters. Keep it stable: changing it signs everyone out and requires re-entering saved secrets.
SESSION_SECRET=

# The first admin account, created on the first sign-in when the database has no admin yet.
# Change the password from Admin → Team & account afterwards.
ADMIN_EMAIL=info@araqah.com
ADMIN_PASSWORD=

# Optional fallbacks. Everything below can be set (and overridden) in the dashboard instead:
#   Admin → Mail server, and Admin → Payment gateway.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Araqah Website <no-reply@araqah.com>"
ADMIN_EMAILS=info@araqah.com
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
