# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Environment files: real values never go in git. Only .env.example is shared.
.env
.env.*
!.env.example

# Local development data (SQLite database and the dev session secret)
.data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Caches
.cache/
.eslintcache
.turbo/
.vercel/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Claude Code: keep the shared dev-server config, ignore personal settings
.claude/*
!.claude/launch.json

# Certificates and keys
*.pem
*.key
*.crt

# Temporary files
tmp/
temp/
*.tmp
